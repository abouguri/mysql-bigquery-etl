# Example .env file for mysql-bigquery-etl

# Google Cloud
GCP_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=mysql_etl
BIGQUERY_LOCATION=US

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=etl_fixture
MYSQL_PASSWORD=local-fixture-only
MYSQL_DATABASE=commerce_fixture

# Environment
ENVIRONMENT=development

# Bounded extraction and inclusive polling lookback
ETL_BATCH_SIZE=10000
ETL_LOOKBACK_SECONDS=86400

# Zero-budget default: no cloud calls or credentials needed
ETL_BACKEND=local
ETL_ALLOW_CLOUD=0
ETL_LOCAL_PATH=local/warehouse.sqlite
